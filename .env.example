# TwinEdge Root Environment Configuration

# Service Ports & Endpoints
PORT=8000
VITE_API_URL=http://localhost:8000
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-auth-token-12345
INFLUXDB_ORG=twinedge
INFLUXDB_BUCKET=telemetry
MQTT_HOST=localhost
MQTT_PORT=1883

# Model & Paths configuration (optional overrides)
TWINEDGE_ROOT=.
TWINEDGE_MODEL_DIR=backend/model
TWINEDGE_DATA_DIR=backend/data
TWINEDGE_REGISTRY_PATH=models/registry.json
TWINEDGE_GOLDEN_DIR=models/golden
TWINEDGE_REPORTS_DIR=reports/model

# Logging & Event Store (sqlite | postgres | dual)
LOG_SINK=sqlite
LOG_READ_STORE=sqlite
LOG_RETENTION_DAYS=14

# PostgreSQL Configuration (profile: pg)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=twinedge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_secret
POSTGRES_APP_USER=twinedge_app
POSTGRES_APP_PASSWORD=twinedge_app_secret
POSTGRES_MIGRATOR_USER=twinedge_migrator
POSTGRES_MIGRATOR_PASSWORD=twinedge_migrator_secret
POSTGRES_RO_USER=twinedge_ro
POSTGRES_RO_PASSWORD=twinedge_ro_secret
