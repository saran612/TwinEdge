# TwinEdge Root Environment Configuration

# Service Ports & Endpoints
PORT=8000
VITE_API_URL=http://localhost:8000
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-auth-token-12345
INFLUXDB_ORG=twinedge
INFLUXDB_BUCKET=telemetry
MQTT_HOST=localhost
MQTT_PORT=1883

# Model & Paths configuration (optional overrides)
TWINEDGE_ROOT=.
TWINEDGE_MODEL_DIR=backend/model
TWINEDGE_DATA_DIR=backend/data
TWINEDGE_REGISTRY_PATH=models/registry.json
TWINEDGE_GOLDEN_DIR=models/golden
TWINEDGE_REPORTS_DIR=reports/model
