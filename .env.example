# TwinEdge Environment Variables (Example Template)
# Copy this file to .env and adjust values for local development or deployment.

# MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace_with_influxdb_admin_token
INFLUXDB_ORG=twinedge
INFLUXDB_BUCKET=telemetry
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=replace_with_secure_password
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=replace_with_influxdb_admin_token

# TwinEdge Alerting Rules
RUL_ALERT_THRESHOLD=60.0
ALERT_SUSTAINED_CYCLES=3
